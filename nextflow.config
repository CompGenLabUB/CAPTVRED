manifest {
    name = 'CompGenLabUB/CAPTVRED'
    author = 'Maria Tarradas-Alemany <mtarradasi@ub.edu>;Josep F Abril Ferrando <jabril@ub.edu>'
    description = 'Pipeline for analyses of viral metagenomics datasets from Target Enrichment Sequencing.'
    version = '1.0.0'
    mainScript = 'main.nf'
    nextflowVersion = '>=22.04.4'
    // nextflowVersion = '>=22.04.5'
}

params{
  //environment parameters:
    //help
    help = false
    cpus = 32

    
    
    // init params
    // working directory
    samp        =  null  // Sample definition tabular filef
    fastq_dir   =  null  // Directory for target species data
  
    runID       =  null  // "RUN00"
    R1          =  "_R1_001"
    R2          =  "_R2_001"
    setname     =  "targetset"

    // refseqs and databases
    
    refdb_name    =  "rvdb_nt"
    set_seqs      =  "setseqs.fasta.gz"  // Fasta file for set species is stores (full path)
    fams_subset   =  "foi_subset_db.fasta.gz" //subset of rvdb conaining only 
    others_subset =  "other_subset_db.fasta.gz"
    full_tax      =  "full_tax.tax.gz"
    set_tax       =  "set_tax.tax.gz"
    use_full_db   =  false
    blastdbname   =  "28012026_temporary_blastdb"
    amplicon_refseqs_dir   =  null //params.refseqs+'/ampliconseqs'
    amplicon_refseqs_info  =  "Viral_candidates_zoonosis_full_info.tsv"



  // filesystem paths:
  
  ctvdir      =  projectDir
  results_dir  =  "${launchDir}/results"
  logs_dir     =  "${results_dir}/logs"  
  tmp_dir      =  "${results_dir}/tmp"
  refseqs     =  "${ctvdir}/references"
  bindir      =  "${ctvdir}/bin"
  db_dir      =  "${refseqs}/db"
  refdb_dir   =  "${db_dir}/${params.refdb_name}"
  gff_dir     =  "${refdb_dir}/gff_refgenomes"
  kaijudir    =  "${db_dir}/kaiju"
  fcsgx_db    =  "${db_dir}/gxdb/all"
  ncbidir     =  "${db_dir}/ncbi"
  dbset_dir   =  "${refseqs}/${params.setname}"
  bbdukREF    =  "${refseqs}/bbmap/resources/adapters.fa"
  


    rawfq_sfx="{fastq,fq}.gz"
    // sampletbl= params.basedir+'/samples_definition.tbl'
  
  
  //
    //NCPUS=32
    // MAXMEM="$MAXMEM"
    // phred="$PhredOffset"up
    
    
  // Cleaning params (BBDuk):
    trim_adapters = true
   // bbdukREF="${params.refseqs}/bbmap/resources/adapters.fa"
    bbdukMINLEN=32
    bbdukMAQ=10
    
  // BOWTIE and Alignment params:
    alignMINQ=13
    bowtie_nmismatch=1
    bowtie_seedlen=18
    
  // Assembly params:
    assembler="megahit"
    assemblyMINCONLEN=180;
    
    trinityMAXM="250G"
    megahit_errorHandler = "finish"

  
  // Taxonomy
     //taxonfast = false
     //taxonslow = false
    taxalg="BLASTN"
    
  // Blast params:
    // blast_approach="BLASTN"
    // blast_ref_db_name="C-RVDBvCurrent_blastdb"
    // blast_ref_db_name="$BL_DB_NM" 
       //"C-RVDBvCurrent_blastdb"
    // blast_ref_db_ids="$BDBD_IDS"
   //  blast_ref_db_info="C-RVDB_allentries_info.txt"
    blast_eval=10e-10
    blast_pident=50
    taxondbsize=5000000000 // about 2 times db size (2428170463)
    
  // ON REFERENCES (SET)
   // general_only = false
  
  // Blast against Viral Candidates (vcan)
    bl_suffix="blastn_on_viralcandidates"
    vcan_eval=0.001
    vcan_pident=50
    
    // do not modify! //
    bl_outfmt="6 qseqid qlen sseqid slen qstart qend sstart send"
    bl_outfmt="${bl_outfmt} length score evalue bitscore pident"
    bl_outfmt="${bl_outfmt} nident mismatch positive gapopen gaps"
    bl_outfmt="${bl_outfmt} ppos qframe sframe qcovs qcovhsp qseq sseq"
    // do not modify! //
    
  // Kaiju Params:
    kaijumaxCPUS=26 
    kaijuMAX_FORKS=4
    kaijuMAX_RETRIES=2
    kaijuDBRAW="nr_euk"   // database for kaiju into raw reads

  
  // Filter params:
    mincovpct=70

  // Handle Contamination:
    handle_contamination = false
    cont_min_cov=100;
  //  if (handle_contamination == true ) {
  //    cids="$contamin_ids";
  //    cfaa="$contamin_faa";
  //  }
  
  //Coverage figures
    do_cov_figures = true

}   
apptainer {
  enabled = true
  autoMounts = true
  cacheDir = "${projectDir}/.singularity"
  runOptions =  "-B ${params.db_dir} --cleanenv"
}

conda {
    enabled = true
    autoCreate = true // Nextflow will create env if missing
    cacheDir = "${projectDir}/conda_envs" // Custom centralized cache
    clean = true // Clean broken envs automatically
}

//Environments
//    conda.enabled = true
//    conda.autoCreate = true      // Nextflow will create env if missing
//    conda.cacheDir   = "$HOME/.conda"  // (optional: isolates pipeline envs)
 
// singularity.enabled     = true
// singularity.autoMounts  = true
// // Define where to save the large container files
// singularity.cacheDir    = "${projectDir}/singularity_cache"

process {
    
    // CONDA:

    withName: /.*/ { 
      //conda = "$workflow.projectDir/environment.yml"
       conda = "${projectDir}/environment.yml" 
      
    }
    // FILESYSTEM:

    publishDir = [ path: "${params.logs_dir}",  pattern: "*.{log}", mode: 'copy' ]
    cpus = params.cpus

    withName: 'fastQC_raw' {
      publishDir = [ path: "${params.results_dir}/raw", mode: 'copy' ]
      
    }

    withName: 'bbduk_clean' {
      publishDir = [ path: "${params.results_dir}/clean", mode: 'copy' ]
      
    }

    withName: 'FCSGX_RUNGX' {
      publishDir = [ path: "${params.results_dir}/clean", mode: 'copy' ]
      publishDir = [ path: "${params.logs_dir}",  pattern: "*.{summary.txt}", mode: 'copy' ]
      
    }
    
    withLabel: 'process_high'  {
        cpus   = 12
        time   = '24h'
        memory = '400 GB'
    }

    withName: 'discard_contaminants' {
      publishDir = [ path: "${params.results_dir}/clean", mode: 'copy' ]
    }

    withName: 'megahit_assembly_new' {
      publishDir = [path: "${params.results_dir}/assembly", mode: 'copy']
      errorStrategy = params.megahit_errorHandler
    }
    withName: 'metaspades_assembly_new' {
      publishDir = [path: "${params.results_dir}/assembly", mode: 'copy']
    }

    withName: 'refine_assembly' {
      publishDir = [ path: "${params.logs_dir}",  pattern: "*.{metrics}", mode: 'copy' ]
      publishDir = [ path: "${params.results_dir}/assembly", mode: 'copy' ]
    }

    withName: 'blast_search' {
      publishDir = [ path: "${params.results_dir}/taxonomy",  mode: 'copy' ]
    }

    withName: 'blast_makedb' {
      publishDir = [ path: "${params.refseqs}/db/blastdb",  mode: 'copy' ]
    }

    withName: 'blast_sum_coverage' {
      publishDir = [ path: "${params.results_dir}/taxonomy", pattern: "*coverage.tbl", mode: 'copy' ]
      publishDir = [ path: "${params.results_dir}/reports", mode: 'copy' ]
    }

    withLabel: 'trinity_crash' {
       errorStrategy = 'ignore'
    }
    

    withLabel: 'limit_kaiju' {
       errorStrategy = 'retry'
       maxRetries = params.kaijuMAX_RETRIES
       maxForks = params.kaijuMAX_FORKS
       if ( params.cpus < params.kaijumaxCPUS ) { 
            cpus=params.cpus 
       } else { 
            cpus=params.kaijumaxCPUS  }
              
       
    }
}

env {

    //Fixing issues with python utf8 libraries
    LANG = "en_US.UTF-8"
    LC_CTYPE = "en_US.UTF-8"
    LC_NUMERIC = "en_US.UTF-8"
    LC_TIME = "en_US.UTF-8"
    LC_COLLATE = "en_US.UTF-8"
    LC_MONETARY = "en_US.UTF-8"
    LC_MESSAGES = "en_US.UTF-8"
    LC_ALL = "en_US.UTF-8"
    
      // Kaiju params
    //kaiju_dbs="viruses, rvdb, refseq, nr_euk"
    
    
    //Further defs
    //BP_LOG = "$BDIR/logs/biopieces"
    BPCOL = 'SEQ_NAME,SEQ_LEN,RES[A],RES[C],RES[G],RES[T],GC%'
    BPCOL = "$BPCOL,SCORES_MIN,SCORES_MAX,SCORES_MEAN,SCORES_MEDIAN"

    TAB = "\t"
    RET = "\n"

    ZERO="###0###"
}

